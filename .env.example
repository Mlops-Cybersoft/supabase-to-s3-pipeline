# Copy to .env. Do not commit the real URL or AWS credentials.
# Get this from Supabase Dashboard -> Database -> Database Access -> Transaction pooler.
# For a custom role, the shared-pooler username is usually <role>.<project-ref>.
SUPABASE_TRANSACTION_POOLER_URL=postgresql://dms_replication.<project-ref>:<url-encoded-password>@aws-<index>-<region>.pooler.supabase.com:6543/postgres?sslmode=require

AWS_DEFAULT_REGION=ap-northeast-2
# Local-only alternative to an AWS CLI profile. Fill these only in your untracked .env;
# never commit access keys. Prefer an IAM role when running on AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Required only for temporary credentials (for example, AWS SSO).
S3_EXPORT_BUCKET=your-s3-bucket
S3_EXPORT_PREFIX=raw/supabase-pooler-export
S3_SERVER_SIDE_ENCRYPTION=AES256
EXPORT_CHUNK_SIZE=5000

# Airflow training consumes exactly one snapshot folder written by the notebook.
# Leave blank to use the latest run_id folder; set a value to train a reproducible snapshot.
S3_TRAINING_RUN_ID=
MIN_ROC_AUC=0.70

# Used by Airflow scheduler and webserver to sign/verify served task-log URLs.
# Change this once for a non-local deployment; all Airflow services must share it.
AIRFLOW__WEBSERVER__SECRET_KEY=local-dev-airflow-log-signing-key-change-before-production

# Every table must define a stable primary key used for deterministic ordering.
EXPORT_TABLES_JSON=[{"schema":"public","table":"enrollees","primary_key":"enrollee_id"},{"schema":"public","table":"enrollee_education","primary_key":"enrollee_id"},{"schema":"public","table":"work_experience","primary_key":"enrollee_id"},{"schema":"public","table":"training_hours","primary_key":"enrollee_id"},{"schema":"public","table":"employment","primary_key":"enrollee_id"},{"schema":"public","table":"city_dev_index","primary_key":"city"}]
